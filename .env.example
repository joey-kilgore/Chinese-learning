# Copy this file to .env and fill in your keys for local development.
# .env is gitignored — never commit real keys.

# Anthropic API key for article generation (Settings screen is used in production).
# Has no effect when USE_MOCK = true in claudeApi.ts.
EXPO_PUBLIC_CLAUDE_API_KEY=sk-ant-...

# Supabase — find these in your project at Settings → API
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
